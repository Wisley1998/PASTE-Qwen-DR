# Frozen common profile for the untouched 60-source v5 live-joint matrix.
#
# The formal wrapper changes only the two registered factors: native FCFS versus
# the physical-KV Joint policy, and speculation off versus visit-only.  Each
# cell starts a fresh server.  Native vLLM prefix caching stays enabled in all
# cells; the experimental explicit prefix-affinity reorder stays disabled.
# Guided-JSON recovery telemetry is retained for diagnosis, but any recovery
# invalidates the formal cell.

export PASTE_LIVE_FORMAL_PROFILE="live_joint_wikipedia_frozen_formal_v5_context10000_visitonly_execaware_attemptgate_retry2_jsonrecovery0"
export PASTE_LIVE_FORMAL_WORKLOAD="reproduction/workloads/live_joint_wikipedia_frozen_formal_v5.json"
export PASTE_LIVE_FORMAL_WORKLOAD_SHA256="6b11193c8a0dbbd70f9ae4bc2c72b56737893b4d45dacd1d9970e01ca019ae31"
export PASTE_LIVE_FORMAL_CANONICAL_SHA256="7e89dea02bf2dfc5bf2b7dd2669c0d753097d5e2e351b26f018eb3df02268fbe"
export PASTE_LIVE_FORMAL_SOURCES_SHA256="478310accbd16ce623a4684465dd029a01efa80bfd299f3522943e90bf2cba46"
export PASTE_LIVE_FORMAL_SOURCE_COUNT="60"
export PASTE_LIVE_FORMAL_DEFAULT_ORDERS="A,B,E,F;B,A,F,E;A,B,F,E"
export PASTE_LIVE_FORMAL_RUN_BASE="reproduction/artifacts/live_joint/formal"
export PASTE_LIVE_GUIDED_JSON_RECOVERY_POLICY_VERSION="escape-unescaped-string-controls-v1"
export PASTE_LIVE_GUIDED_JSON_RECOVERY_MODULE_SHA256="678864a738084076bb21a181cf15baa24c5839599fc5547303b269bb9e8c8455"
export PASTE_LIVE_FORMAL_MAX_GUIDED_JSON_RECOVERIES="0"

export PASTE_ENV_PREFIX="/home/aiscuser/.conda/envs/paste"
export HF_HOME="/home/aiscuser/hf_cache"
export CUDA_VISIBLE_DEVICES="4,5,6,7"
export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
