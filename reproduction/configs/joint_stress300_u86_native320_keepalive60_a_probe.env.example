# Frozen A-only retry-clean load probe for stress300 / native320 / graph256.
#
# r1 and r2 each encountered one approximately 1 ms stale pooled-connection
# failure: aiohttp retains idle connections for 15 seconds while vLLM defaults
# to a 5-second HTTP keep-alive.  This profile changes no model, workload, or
# scheduling control.  It raises the server keep-alive to 60 seconds so it is
# strictly longer than the unchanged client pool timeout.

export PASTE_STRESS_PROFILE="stress300_native320_g256_u86_keepalive60_a_probe"
export PASTE_FIXED_WORKLOAD_MANIFEST="reproduction/artifacts/workloads/fixed_three_way_cap512_floor64/manifest_stress300.json"
export PASTE_STRESS_RUN_BASE="reproduction/artifacts/stress300_u86_native320_g256_keepalive60_a_probe"

# Preregistered A-side acceptance gates, unchanged from r1/r2.
export PASTE_NATURAL_QUEUE_MIN_WAITING_SAMPLE_FRACTION="0.50"
export PASTE_NATURAL_QUEUE_MIN_QUEUE_TIME_FRACTION="0.20"
export PASTE_NATURAL_QUEUE_MAX_PREEMPTIONS_PER_REQUEST="0.25"

# Replay and reliability policy.
export PASTE_TRACE_SPEEDUP="10"
export PASTE_MAX_ACTIVE_TRACES="300"
export PASTE_MAX_REQUEST_ATTEMPTS="2"
export PASTE_TOOL_PREDICTION_TOP_K="5"
export PASTE_SCHEDULER_METADATA_MODE="online"

# Four-GPU engine shape.  The only r1/r2 transport change is the explicit
# server-side keep-alive; max-num-seqs remains nonbinding (320 > 300).
export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
export MODEL_REVISION="4b0ac5767427a55d08a254f0367e2934976598e0"
export VLLM_HOST="127.0.0.1"
export VLLM_PROBE_HOST="127.0.0.1"
export VLLM_TP_SIZE="4"
export VLLM_DTYPE="bfloat16"
export VLLM_MAX_MODEL_LEN="16384"
export VLLM_GPU_MEMORY_UTILIZATION="0.86"
export VLLM_MAX_NUM_BATCHED_TOKENS="8192"
export VLLM_MAX_NUM_SEQS="320"
export VLLM_CUDA_GRAPH_SIZES="256"
export VLLM_USE_V1="1"
export VLLM_HTTP_TIMEOUT_KEEP_ALIVE="60"

# Prospective Joint values are frozen even though this A cell runs FCFS.
