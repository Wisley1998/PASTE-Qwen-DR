# Unified workset v1: Qwen DeepResearch FULL server profile.
#
# Source this file before reproduction/scripts/start_vllm.sh.  GPU placement,
# port, state directory, and log directory are deliberately left to the run
# command so two isolated TP=4 cells can coexist.  For the FCFS baseline, keep
# every model/engine setting identical and override only:
#
#   export VLLM_SCHED_POLICY="fcfs"
#
# The other scheduler variables are inert because start_vllm.sh does not load
# the hook for FCFS.

export PASTE_ENV_PREFIX="/home/aiscuser/.conda/envs/paste"
export HF_HOME="/home/aiscuser/hf_cache"
export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
export MODEL_REVISION="4b0ac5767427a55d08a254f0367e2934976598e0"

# Hardware-equivalent settings for both cells.
export VLLM_HOST="127.0.0.1"
export VLLM_PROBE_HOST="127.0.0.1"
export VLLM_TP_SIZE="4"
export VLLM_DTYPE="bfloat16"
export VLLM_MAX_MODEL_LEN="16384"
export VLLM_GPU_MEMORY_UTILIZATION="0.86"
export VLLM_MAX_NUM_BATCHED_TOKENS="2048"
export VLLM_MAX_NUM_SEQS="48"
export VLLM_CUDA_GRAPH_SIZES="32"
export VLLM_ENABLE_PREFIX_CACHING="1"
export VLLM_USE_V1="1"
export VLLM_REQUIRE_NEW="1"
export VLLM_READY_TIMEOUT="3600"
export VLLM_START_CLEANUP_TIMEOUT="60"
export VLLM_SHUTDOWN_TIMEOUT="60"

# FULL policy and per-request service estimates.
export VLLM_SCHED_POLICY="online_joint_pacer_v2"
export VLLM_SCHED_PRED_OUT_ENABLE="1"
export VLLM_SCHED_PRED_OUT_EMA_ALPHA="0.5"
export VLLM_SCHED_DEFAULT_PRED_OUT="128"
export VLLM_SCHED_AVG_CALL_SERVICE_S="2.0"
export VLLM_SCHED_PREFILL_TOKENS_PER_S_V2="38112"
export VLLM_SCHED_DECODE_TOKENS_PER_S_V2="113.7"
export VLLM_SCHED_OAS_V3_CONTEXT_TOKENS_PER_S="6000"
export VLLM_SCHED_TIME_AGING_ALPHA="0.2"

# Session-persistent foreground window and decode-pressure band.
export VLLM_SCHED_JOINT_V2_FOREGROUND_MAX_SESSIONS="40"
export VLLM_SCHED_JOINT_V2_GATE_MIN_RUNNING="16"
export VLLM_SCHED_JOINT_V2_GATE_MAX_WAIT_S="180"
export VLLM_SCHED_JOINT_V2_DEADLINE_MIN_RUNNING="32"
export VLLM_SCHED_JOINT_V2_DECODE_TARGET_RUNNING="32"
export VLLM_SCHED_JOINT_V2_DECODE_MAX_RUNNING="33"

# Intersect physical-KV safety with the Joint foreground/decode limits.  The
# RESPECT flag is essential: without it, spare KV can admit all 48 sequences
# and silently bypass the working set.
export VLLM_SCHED_JOINT_V2_NATIVE_ADMISSION="0"
export VLLM_SCHED_JOINT_V2_PHYSICAL_KV_ADMISSION="1"
export VLLM_SCHED_JOINT_V2_PHYSICAL_RESPECT_JOINT_LIMITS="1"
export VLLM_SCHED_JOINT_V2_PHYSICAL_KV_TARGET_UTILIZATION="0.93"
export VLLM_SCHED_JOINT_V2_PHYSICAL_KV_RESCUE_WAIT_S="180"
export VLLM_SCHED_JOINT_V2_PHYSICAL_KV_LOG_INTERVAL_S="1"

# Remaining task work and preserved speculative-tool benefit.  `rlmt` and
# `eg` are frozen trace-derived fields; see reproduction/UNIFIED_WORKSET_V1.md
# for the evaluation boundary.
export VLLM_SCHED_JOINT_V2_REMAINING_LLM_WEIGHT="1"
export VLLM_SCHED_JOINT_V2_REALIZED_GAIN_WEIGHT="0.25"
export VLLM_SCHED_JOINT_V2_FINAL_LANE="1"
export VLLM_SCHED_JOINT_V2_REMAINING_CALL_LANE="0"
export VLLM_SCHED_JOINT_V2_REMAINING_CALL_COARSE_LANES="0"
export VLLM_SCHED_JOINT_V2_REMAINING_CALL_SOFT_WEIGHT_S="0"
export VLLM_SCHED_JOINT_V2_RUNNING_PRIORITY="0"
export VLLM_SCHED_JOINT_V2_RUNNING_PRIORITY_MAX_WAIT_S="0"
export VLLM_SCHED_JOINT_V2_PREFIX_LOCALITY="0"
export VLLM_SCHED_JOINT_V2_PREFIX_LOCALITY_WEIGHT="1"

# Joint-v2 score calibration.
export VLLM_SCHED_JOINT_V2_TAIL_BETA="0.25"
export VLLM_SCHED_JOINT_V2_TOOL_BETA="0.9"
export VLLM_SCHED_JOINT_V2_TOOL_WAIT_CAP_S="80"
export VLLM_SCHED_JOINT_V2_REMAINING_TOOL_WEIGHT="0.35"
export VLLM_SCHED_JOINT_V2_CONTEXT_ALPHA="1.4"
export VLLM_SCHED_JOINT_V2_CONTEXT_REF_TOKENS="8000"
export VLLM_SCHED_JOINT_V2_FINAL_BONUS_S="12"
export VLLM_SCHED_JOINT_V2_PROGRESS_BONUS_S="8"
export VLLM_SCHED_JOINT_V2_NEW_SESSION_PENALTY_S="4"
export VLLM_SCHED_JOINT_V2_OVER_BUDGET_PENALTY_S="120"

# Conservative context forecasts used by ordering and admission.
export VLLM_SCHED_HBM_MIN_RUNNING_REQS="16"
export VLLM_SCHED_HBM_MAX_ADMIT_PER_STEP="16"
export VLLM_SCHED_HBM_LONG_CONTEXT_TOKENS="16000"
export VLLM_SCHED_HBM_MAX_LONG_RUNNING="16"
export VLLM_SCHED_HBM_TARGET_CONTEXT_TOKENS="786432"
export VLLM_SCHED_HBM_MIN_CONTEXT_TOKENS="524288"
export VLLM_SCHED_HBM_MAX_CONTEXT_TOKENS="1048576"
export VLLM_SCHED_HBM_VIRTUAL_FILL_RATIO="0.96"
