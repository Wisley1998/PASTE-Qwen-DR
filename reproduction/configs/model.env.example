# Copy this file to a private shell environment file, edit if needed, then run:
#   set -a; source /path/to/model.env; set +a
# Do not store Hugging Face or endpoint credentials in a committed file.

export PASTE_ENV_PREFIX="${HOME}/.conda/envs/paste"
export HF_HOME="${HOME}/hf_cache"

export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
export MODEL_REVISION="4b0ac5767427a55d08a254f0367e2934976598e0"
# Normally derived from HF_HOME, MODEL_ID, and MODEL_REVISION by the scripts.
# export MODEL_SNAPSHOT="${HF_HOME}/models--Alibaba-NLP--Tongyi-DeepResearch-30B-A3B/snapshots/${MODEL_REVISION}"

export VLLM_HOST="127.0.0.1"
export VLLM_PROBE_HOST="127.0.0.1"
export VLLM_PORT="8000"
export VLLM_TP_SIZE="4"
export VLLM_DTYPE="bfloat16"
export VLLM_MAX_MODEL_LEN="16384"
export VLLM_GPU_MEMORY_UTILIZATION="0.83"
export VLLM_MAX_NUM_BATCHED_TOKENS="8192"
export VLLM_MAX_NUM_SEQS="16"
export VLLM_USE_V1="1"

# fcfs is the baseline. Non-fcfs policies load scripts/pythonhooks and are
# accepted only when startup logs confirm that the vLLM v1 hook was installed.
export VLLM_SCHED_POLICY="fcfs"
export VLLM_READY_TIMEOUT="3600"
export VLLM_START_CLEANUP_TIMEOUT="60"
export VLLM_SHUTDOWN_TIMEOUT="60"

# Optional server/client credential. start_vllm.sh enables authentication when
# it is set, and smoke_vllm.py sends it. Supply it only in the shell; never
# commit its value.
# export VLLM_API_KEY=""
