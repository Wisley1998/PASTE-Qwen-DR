# Live-vLLM replay of the materialized 0.42x all-visit trace.
# Search/other tools sleep for corrected service time; Visit uses the shared,
# preemptible wall-clock executor in run_trace_all_visit_live.py.

export PASTE_ENV_PREFIX="/home/aiscuser/.conda/envs/paste"
export HF_HOME="/home/aiscuser/hf_cache"
export CUDA_VISIBLE_DEVICES="4,5,6,7"
export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
