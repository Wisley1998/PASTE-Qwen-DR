# Prospectively frozen v2 development-only profile for the standalone
# native-prefix causal test. The rejected r1/v1 diagnostic is not eligible for
# revalidation or promotion under this contract.
#
# The matrix has exactly two cells.  P0 disables vLLM's native prefix cache and
# P1 enables it.  Both use native FCFS; the wrapper deletes every inherited
# VLLM_* variable, reconstructs an allowlisted engine environment, and starts
# through an empty isolated PYTHONPATH so no scheduler hook can load.  The
# prompt driver talks only to the loopback vLLM endpoint and executes no tools.

export PASTE_PREFIX_CAUSAL_PROFILE="native_prefix_causal_dev_v2_context10000_fcfs_local48_single_token"
export PASTE_PREFIX_CAUSAL_WORKLOAD="reproduction/workloads/live_joint_wikipedia_frozen_tune_v1.json"
export PASTE_PREFIX_CAUSAL_WORKLOAD_SHA256="e9f63f75bb80c840fbc59f2aa9a581527669c10fc761a4649f50a1bc03eaf1ea"
export PASTE_PREFIX_CAUSAL_SOURCE_COUNT="16"
export PASTE_PREFIX_CAUSAL_REPLICAS="3"
export PASTE_PREFIX_CAUSAL_TASK_COUNT="48"
export PASTE_PREFIX_CAUSAL_CALLS_PER_TASK="3"
export PASTE_PREFIX_CAUSAL_ORDERS="P0,P1;P1,P0"
export PASTE_PREFIX_CAUSAL_RUN_BASE="reproduction/artifacts/live_joint/prefix_native_causal_dev_v2"

export PASTE_ENV_PREFIX="/home/aiscuser/.conda/envs/paste"
export HF_HOME="/home/aiscuser/hf_cache"
export CUDA_VISIBLE_DEVICES="4,5,6,7"
export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
export MODEL_REVISION="4b0ac5767427a55d08a254f0367e2934976598e0"
export VLLM_HOST="127.0.0.1"
export VLLM_PROBE_HOST="127.0.0.1"
export VLLM_PORT="8100"
export VLLM_TP_SIZE="4"
export VLLM_DTYPE="bfloat16"
export VLLM_MAX_MODEL_LEN="16384"
export VLLM_GPU_MEMORY_UTILIZATION="0.86"
export VLLM_MAX_NUM_BATCHED_TOKENS="2048"
export VLLM_MAX_NUM_SEQS="96"
export VLLM_CUDA_GRAPH_SIZES="32"
export VLLM_USE_V1="1"
export VLLM_HTTP_TIMEOUT_KEEP_ALIVE="60"
export VLLM_READY_TIMEOUT="3600"
export VLLM_SHUTDOWN_TIMEOUT="60"

# Prompt topology: private 10k-token history, then deterministic search and
# visit turns.  The visit fixture adds roughly 900 content tokens so the three
# prompts track the live formal shape (~10.2k/~10.4k/~11.4k tokens).
export PASTE_PREFIX_CONTEXT_PADDING_TOKENS="10000"
export PASTE_PREFIX_VISIT_FIXTURE_TOKENS="900"
export PASTE_PREFIX_MAX_ACTIVE_TASKS="48"
export PASTE_PREFIX_REQUEST_TIMEOUT_S="300"
export PASTE_PREFIX_QUEUE_SAMPLE_INTERVAL_S="0.2"
# Generation-side control: the pinned tokenizer must prove that A is exactly
# one non-special token with an exact decode round trip. vLLM receives a
# singleton guided_choice and max_tokens=1 on every call.
export PASTE_PREFIX_SENTINEL="A"
export PASTE_PREFIX_OUTPUT_CONSTRAINT="guided_choice_singleton_v1"
export PASTE_PREFIX_MAX_TOKENS_CALL0="1"
export PASTE_PREFIX_MAX_TOKENS_CALL1="1"
export PASTE_PREFIX_MAX_TOKENS_CALL2="1"

# Prospectively frozen, conjunctive promotion gates.
export PASTE_PREFIX_MIN_NATIVE_HIT_RATIO="0.60"
export PASTE_PREFIX_MIN_PREFILL_REDUCTION="0.15"
export PASTE_PREFIX_MIN_MEAN_REQUEST_REDUCTION="0.03"
export PASTE_PREFIX_MIN_MEAN_TASK_E2E_REDUCTION="0.03"
export PASTE_PREFIX_MAX_TASK_P95_RATIO="1.03"
export PASTE_PREFIX_MAX_COMPLETION_TOKEN_RELATIVE_DIFFERENCE="0.01"
export PASTE_PREFIX_BOOTSTRAP_SAMPLES="10000"
export PASTE_PREFIX_BOOTSTRAP_SEED="20260816"
