# Frozen configuration for the queued stress180 / target64 stage-aware pair.
# reproduction/scripts/run_joint_stress_pair.sh sources this file.
#
# This is a tuned load-sensitivity profile, not an untouched final workload:
# 60 independent source sessions are each replayed in three deterministic
# prefix variants (180 load instances, 1,557 requests per cell).

export PASTE_STRESS_PROFILE="stress180_target64_u86"
export PASTE_FIXED_WORKLOAD_MANIFEST="reproduction/artifacts/workloads/fixed_three_way_cap512_floor64/manifest_stress180.json"
export PASTE_STRESS_RUN_BASE="reproduction/artifacts/stress180_u86_stage_formal"

# Trace replay and retry policy.
export PASTE_TRACE_SPEEDUP="10"
export PASTE_MAX_ACTIVE_TRACES="180"
export PASTE_MAX_REQUEST_ATTEMPTS="2"
export PASTE_TOOL_PREDICTION_TOP_K="5"
export PASTE_SCHEDULER_METADATA_MODE="online"

# Pinned local vLLM shape: four visible GPUs, 16K context, 64 live sequences.
export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
export MODEL_REVISION="4b0ac5767427a55d08a254f0367e2934976598e0"
export VLLM_HOST="127.0.0.1"
export VLLM_PROBE_HOST="127.0.0.1"
export VLLM_TP_SIZE="4"
export VLLM_DTYPE="bfloat16"
export VLLM_MAX_MODEL_LEN="16384"
export VLLM_GPU_MEMORY_UTILIZATION="0.86"
export VLLM_MAX_NUM_BATCHED_TOKENS="8192"
export VLLM_MAX_NUM_SEQS="64"
export VLLM_USE_V1="1"

# Causal online predictor and stage-aware scheduler.
export VLLM_SCHED_PRED_OUT_ENABLE="1"
export VLLM_SCHED_PRED_OUT_EMA_ALPHA="0.5"
export VLLM_SCHED_DEFAULT_PRED_OUT="357"
export VLLM_SCHED_AVG_CALL_SERVICE_S="3.3"
export VLLM_SCHED_PREFILL_TOKENS_PER_S_V2="38112"
export VLLM_SCHED_DECODE_TOKENS_PER_S_V2="113.7"
export VLLM_SCHED_TIME_AGING_ALPHA="0.2"
export VLLM_SCHED_JOINT_V2_FOREGROUND_MAX_SESSIONS="64"
export VLLM_SCHED_JOINT_V2_GATE_MIN_RUNNING="48"
export VLLM_SCHED_JOINT_V2_GATE_MAX_WAIT_S="40"
export VLLM_SCHED_JOINT_V2_FINAL_LANE="1"
export VLLM_SCHED_JOINT_V2_REMAINING_CALL_LANE="1"
# 64 preserves the mean-optimized screening behavior. A separate bounded-
# fairness screen uses 63/120s and is not silently substituted here.
export VLLM_SCHED_JOINT_V2_DEADLINE_MIN_RUNNING="64"
export VLLM_SCHED_JOINT_V2_DECODE_TARGET_RUNNING="64"
export VLLM_SCHED_JOINT_V2_DECODE_MAX_RUNNING="64"
export VLLM_SCHED_JOINT_V2_TAIL_BETA="0.25"
export VLLM_SCHED_JOINT_V2_TOOL_BETA="0.9"
export VLLM_SCHED_JOINT_V2_TOOL_WAIT_CAP_S="80"
export VLLM_SCHED_JOINT_V2_REMAINING_TOOL_WEIGHT="0.35"
export VLLM_SCHED_JOINT_V2_CONTEXT_ALPHA="1.4"
export VLLM_SCHED_JOINT_V2_CONTEXT_REF_TOKENS="16000"
export VLLM_SCHED_JOINT_V2_FINAL_BONUS_S="28"
export VLLM_SCHED_JOINT_V2_PROGRESS_BONUS_S="18"
export VLLM_SCHED_JOINT_V2_NEW_SESSION_PENALTY_S="8"
export VLLM_SCHED_JOINT_V2_OVER_BUDGET_PENALTY_S="240"

# HBM controller. The decode target/max remain at native capacity, so this
# profile does not claim a below-capacity pacing effect.
export VLLM_SCHED_HBM_MIN_RUNNING_REQS="24"
export VLLM_SCHED_HBM_MAX_ADMIT_PER_STEP="16"
export VLLM_SCHED_HBM_LONG_CONTEXT_TOKENS="16000"
export VLLM_SCHED_HBM_MAX_LONG_RUNNING="16"
export VLLM_SCHED_HBM_TARGET_CONTEXT_TOKENS="786432"
export VLLM_SCHED_HBM_MIN_CONTEXT_TOKENS="524288"
export VLLM_SCHED_HBM_MAX_CONTEXT_TOKENS="1048576"
export VLLM_SCHED_HBM_LOW_PRESSURE="0.82"
export VLLM_SCHED_HBM_HIGH_PRESSURE="1.02"
export VLLM_SCHED_HBM_BUDGET_INCREASE="1.02"
export VLLM_SCHED_HBM_BUDGET_DECREASE="0.97"
export VLLM_SCHED_HBM_CONTROL_INTERVAL_S="5"
export VLLM_SCHED_HBM_VIRTUAL_FILL_RATIO="0.96"
