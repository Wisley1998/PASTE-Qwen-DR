# Frozen A-only load-selection probe for stress240 / native256.
#
# This profile deliberately cannot run D.  Select or reject the offered load
# from an FCFS-only run before observing any Joint result, so the workload is
# not chosen for a favorable A/D gain.  The workload has 240 active traces
# (four deterministic instances of each of 60 heldout source sessions), while
# max-num-seqs is 256.  Thus the sequence-count cap has 16 requests of
# configuration headroom and is mathematically unable to create the queue.

export PASTE_STRESS_PROFILE="stress240_native256_g256_u86_a_probe"
export PASTE_FIXED_WORKLOAD_MANIFEST="reproduction/artifacts/workloads/fixed_three_way_cap512_floor64/manifest_stress240.json"
export PASTE_STRESS_RUN_BASE="reproduction/artifacts/stress240_u86_native256_g256_a_probe"

# Replay and reliability policy.
export PASTE_TRACE_SPEEDUP="10"
export PASTE_MAX_ACTIVE_TRACES="240"
export PASTE_MAX_REQUEST_ATTEMPTS="2"
export PASTE_TOOL_PREDICTION_TOP_K="5"
export PASTE_SCHEDULER_METADATA_MODE="online"

# A-only acceptance gates, evaluated after the cell drains.  Recomputation
# preemptions do not invalidate a native queue, but a rate above 0.25 per
# logical request rejects this load as a primary comparison because the run
# would be dominated by recomputation churn.  CPU KV swap is always rejected.
export PASTE_NATURAL_QUEUE_MIN_WAITING_SAMPLE_FRACTION="0.50"
export PASTE_NATURAL_QUEUE_MIN_QUEUE_TIME_FRACTION="0.20"
export PASTE_NATURAL_QUEUE_MAX_PREEMPTIONS_PER_REQUEST="0.25"

# Four-GPU vLLM shape. CUDA graph 256 is a capture shape, not an admission
# ceiling.  max-num-seqs=256 exceeds the offered-concurrency upper bound 240.
export MODEL_ID="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"
export MODEL_REVISION="4b0ac5767427a55d08a254f0367e2934976598e0"
export VLLM_HOST="127.0.0.1"
export VLLM_PROBE_HOST="127.0.0.1"
export VLLM_TP_SIZE="4"
export VLLM_DTYPE="bfloat16"
export VLLM_MAX_MODEL_LEN="16384"
export VLLM_GPU_MEMORY_UTILIZATION="0.86"
export VLLM_MAX_NUM_BATCHED_TOKENS="8192"
export VLLM_MAX_NUM_SEQS="256"
export VLLM_CUDA_GRAPH_SIZES="256"
export VLLM_USE_V1="1"

# Keep the prospective D configuration fully recorded even though this
# selection profile permits only A.  Native admission makes Joint reorder-only:
# it cannot lower max_num_running_reqs or reserve a private capacity band.
export VLLM_SCHED_PRED_OUT_ENABLE="1"
export VLLM_SCHED_PRED_OUT_EMA_ALPHA="0.5"
export VLLM_SCHED_DEFAULT_PRED_OUT="357"
export VLLM_SCHED_AVG_CALL_SERVICE_S="3.3"
export VLLM_SCHED_PREFILL_TOKENS_PER_S_V2="38112"
export VLLM_SCHED_DECODE_TOKENS_PER_S_V2="113.7"
export VLLM_SCHED_OAS_V3_CONTEXT_TOKENS_PER_S="6000"
export VLLM_SCHED_TIME_AGING_ALPHA="0.2"
export VLLM_SCHED_JOINT_V2_FOREGROUND_MAX_SESSIONS="256"
export VLLM_SCHED_JOINT_V2_GATE_MIN_RUNNING="48"
export VLLM_SCHED_JOINT_V2_GATE_MAX_WAIT_S="40"
export VLLM_SCHED_JOINT_V2_FINAL_LANE="1"
export VLLM_SCHED_JOINT_V2_REMAINING_CALL_LANE="1"
export VLLM_SCHED_JOINT_V2_REMAINING_CALL_COARSE_LANES="1"
export VLLM_SCHED_JOINT_V2_DEADLINE_MIN_RUNNING="48"
export VLLM_SCHED_JOINT_V2_DECODE_TARGET_RUNNING="256"
export VLLM_SCHED_JOINT_V2_DECODE_MAX_RUNNING="256"
export VLLM_SCHED_JOINT_V2_NATIVE_ADMISSION="1"
export VLLM_SCHED_JOINT_V2_RUNNING_PRIORITY="0"
export VLLM_SCHED_JOINT_V2_RUNNING_PRIORITY_MAX_WAIT_S="0"
export VLLM_SCHED_JOINT_V2_TAIL_BETA="0.25"
export VLLM_SCHED_JOINT_V2_TOOL_BETA="0.9"
export VLLM_SCHED_JOINT_V2_TOOL_WAIT_CAP_S="80"
export VLLM_SCHED_JOINT_V2_REMAINING_TOOL_WEIGHT="0.35"
export VLLM_SCHED_JOINT_V2_CONTEXT_ALPHA="1.4"
export VLLM_SCHED_JOINT_V2_CONTEXT_REF_TOKENS="16000"
export VLLM_SCHED_JOINT_V2_FINAL_BONUS_S="28"
export VLLM_SCHED_JOINT_V2_PROGRESS_BONUS_S="18"
export VLLM_SCHED_JOINT_V2_NEW_SESSION_PENALTY_S="8"
export VLLM_SCHED_JOINT_V2_OVER_BUDGET_PENALTY_S="240"

# These estimates can rank D's waiting queue later; with native admission they
# do not change native capacity.  They are frozen now to prevent post-A drift.
export VLLM_SCHED_HBM_MIN_RUNNING_REQS="24"
export VLLM_SCHED_HBM_MAX_ADMIT_PER_STEP="16"
export VLLM_SCHED_HBM_LONG_CONTEXT_TOKENS="16000"
export VLLM_SCHED_HBM_MAX_LONG_RUNNING="16"
export VLLM_SCHED_HBM_TARGET_CONTEXT_TOKENS="786432"
