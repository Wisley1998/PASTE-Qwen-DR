# Frozen common profile for the untouched 60-source live-joint formal matrix.
#
# This file contains no cell-dependent choice.  The formal wrapper changes
# only VLLM_SCHED_POLICY (FCFS for A/B, Joint for E/F) and speculation mode
# (off for A/E, search_visit for B/F).  Native vLLM prefix caching is enabled
# in every cell; the experimental explicit prefix-affinity reorder is disabled.

export PASTE_LIVE_FORMAL_PROFILE="live_joint_wikipedia_frozen_formal_v3_context5600_retry2_nohidden"
