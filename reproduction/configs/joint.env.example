# Small, trace-driven functional A/B on 4 x A100 40 GB.
# These count/capacity values scale the repository's scheduler to 30 sessions;
# they are not claimed to be the paper's unpublished production tuning.

export PASTE_EVAL_SESSION_LIMIT="30"
export PASTE_TRACE_SPEEDUP="10"
export PASTE_MAX_ACTIVE_TRACES="30"
export VLLM_MAX_NUM_SEQS="8"

export VLLM_SCHED_JOINT_V2_FOREGROUND_MAX_SESSIONS="6"
export VLLM_SCHED_JOINT_V2_GATE_MIN_RUNNING="4"
export VLLM_SCHED_HBM_MIN_RUNNING_REQS="4"
export VLLM_SCHED_HBM_MAX_ADMIT_PER_STEP="4"
export VLLM_SCHED_HBM_LONG_CONTEXT_TOKENS="12000"
export VLLM_SCHED_HBM_MAX_LONG_RUNNING="2"
export VLLM_SCHED_HBM_TARGET_CONTEXT_TOKENS="196608"
export VLLM_SCHED_HBM_MIN_CONTEXT_TOKENS="131072"
export VLLM_SCHED_HBM_MAX_CONTEXT_TOKENS="262144"

# Keep output-size scheduling causal: initial calibration plus completed-call EMA.
export VLLM_SCHED_PRED_OUT_ENABLE="1"

